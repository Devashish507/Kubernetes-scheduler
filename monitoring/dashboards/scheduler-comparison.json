      },
      "id": 1,
      "title": "\u26a1 Live Power Consumption (Simulated Linear Model: P(u) = P_idle + u\u00b7(P_max - P_idle))",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total estimated power across all worker nodes in Watts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 160
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vector(\n  scalar(20 + 40 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker\"})) / 100))\n+ scalar(40 + 80 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker2\"})) / 100))\n+ scalar(80 + 120 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker3\"})) / 100))\n)",
          "legendFormat": "Total Cluster Power",
          "refId": "A"
        }
      ],
      "title": "Total Cluster Estimated Power (W)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Per-node real-time power gauges showing heterogeneous server tiers.",
