        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 200,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 110
              }
            ]
          },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "20 + 40 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker\"})) / 100)",
          "legendFormat": "energy-worker (Efficient: 20\u201360W)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "40 + 80 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker2\"})) / 100)",
          "legendFormat": "energy-worker2 (Medium: 40\u2013120W)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "80 + 120 * (((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)) * on(instance) group_left(nodename) (node_uname_info{nodename=\"energy-worker3\"})) / 100)",
          "legendFormat": "energy-worker3 (Power-Hungry: 80\u2013200W)",
          "refId": "C"
        }
      ],
      "title": "Per-Node Estimated Power Gauges (W)",
      "type": "stat"
    },
